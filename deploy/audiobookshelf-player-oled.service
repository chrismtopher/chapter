[Unit]
Description=Chapter Player for Audiobookshelf OLED appliance display
DefaultDependencies=no
Wants=audiobookshelf-player-boot-splash.service
After=systemd-modules-load.service audiobookshelf-player-boot-splash.service
Before=basic.target

[Service]
Type=simple
User=chapter
WorkingDirectory=/home/chapter/audiobookshelf-player
Environment=HOME=/home/chapter
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m abs_kids_player.oled_service --boot-splash-handoff-path=
StandardOutput=append:/home/chapter/audiobookshelf-player-oled.log
StandardError=append:/home/chapter/audiobookshelf-player-oled.log
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sysinit.target
